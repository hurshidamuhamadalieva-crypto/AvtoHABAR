# ─── Telegram Bot ────────────────────────────────────────────
BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe

# ─── Admin Settings ───────────────────────────────────────────
# Comma-separated Telegram IDs of admins
ADMIN_IDS=111111111,222222222
# Admin Telegram username — with or without leading @, both work
ADMIN_USERNAME=your_admin_username

# ─── Telethon (Telegram API) ──────────────────────────────────
# Get from https://my.telegram.org
API_ID=00000000
API_HASH=your_api_hash_here

# ─── Database ─────────────────────────────────────────────────
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# PostgreSQL (optional):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname

# ─── Payment Settings ─────────────────────────────────────────
# Card transfer details shown to users during "Karta orqali to'lash"
CARD_NUMBER=0000 0000 0000 0000
CARD_HOLDER=YOUR NAME HERE

# ─── Proxies (tavsiya etiladi — ko'p akkaunt + Railway kabi serverlarda) ──────
# Bitta serverdan (Railway va h.k.) bir nechta akkaunt ulanmoqchi bo'lsangiz,
# Telegram bir xil IP'dan ketma-ket kelayotgan "kod yubor" so'rovlarini
# shubhali deb hisoblab, ba'zilariga kodni yubormasligi mumkin.
# Bu yerga bir nechta SOCKS5 proksi qo'shsangiz, bot har bir yangi login
# urinishida navbatdagi proksidan foydalanadi (aylantirib turadi).
#
# Format: host:port yoki host:port:username:password — vergul bilan ajrating.
# Bo'sh qoldirsangiz — proksisiz, to'g'ridan-to'g'ri ulanadi.
PROXIES=31.59.20.176:6754:qahcvseo:8mvl9f2d6m54,31.56.127.193:7684:qahcvseo:8mvl9f2d6m54,45.38.107.97:6014:qahcvseo:8mvl9f2d6m54,198.105.121.200:6462:qahcvseo:8mvl9f2d6m54,64.137.96.74:6641:qahcvseo:8mvl9f2d6m54,198.23.243.226:6361:qahcvseo:8mvl9f2d6m54,38.154.185.97:6370:qahcvseo:8mvl9f2d6m54,84.247.60.125:6095:qahcvseo:8mvl9f2d6m54,142.111.67.146:5611:qahcvseo:8mvl9f2d6m54,191.96.254.138:6185:qahcvseo:8mvl9f2d6m54
PROXY_TYPE=socks5
